@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Propagate dependencies so consumers don't have to relink them
find_dependency(OpenArmCAN REQUIRED)
find_dependency(Eigen3 REQUIRED)
find_dependency(orocos_kdl REQUIRED)
find_dependency(kdl_parser REQUIRED)
find_dependency(urdfdom REQUIRED)
find_dependency(urdfdom_headers REQUIRED)
find_dependency(yaml-cpp REQUIRED)
# These are only needed by the ROS executables, but harmless to list
find_dependency(rclcpp QUIET)
find_dependency(sensor_msgs QUIET)

# Import the exported targets with the correct namespace
include("${CMAKE_CURRENT_LIST_DIR}/openarm_teleopTargets.cmake")


